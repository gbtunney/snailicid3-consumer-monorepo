{
    "name": "@gbt/template-example-react",
    "version": "0.0.1",
    "private": true,
    "description": "Example child package in monorepo",
    "scripts": {
        "build:nx": "nx run $npm_package_name:build",
        "build:storybook:nx": "nx run $npm_package_name:build:storybook",
        "dev:nx": "nx run $npm_package_name:dev",
        "dev:storybook": "pnpm exec nx run -p $npm_package_name -t build:ts check:ts && pnpm exec storybook dev -p 6006",
        "test:nx": "nx run $npm_package_name:test",
        "clean:nx": "nx run $npm_package_name:clean",
        "chromatic:nx": "nx run $npm_package_name:chromatic",
        "test:chromatic": "pnpm exec dotenv -- pnpm chromatic:nx"
    },
    "nx": {
        "targets": {
            "dev": {},
            "dev:ts": {},
            "dev:tsdown": {},
            "dev:vite": {},
            "check:ts": {},
            "build:tsdown": {},
            "build:ts": {},
            "build": {
                "dependsOn": [
                    "build:ts",
                    "build:tsdown"
                ]
            },
            "build:storybook": {},
            "chromatic": {
                "command": "pnpm exec chromatic --project-token=$CHROMATIC_PROJECT_TOKEN_EXAMPLE_REACT --build-script-name build:storybook:nx"
            },
            "test": {},
            "test:watch": {},
            "lint": {},
            "fix": {},
            "clean": {},
            "clean:ts": {},
            "clean:build": {}
        }
    },
    "dependencies": {
        "@snailicid3/utils": "^0.1.0"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^5.4.0",
        "@snailicid3/build-config": "^0.2.0",
        "@snailicid3/config": "^0.3.2",
        "@snailicid3/storybook-config": "^0.1.3",
        "@storybook/addon-a11y": "^10.6.1",
        "@storybook/addon-docs": "^10.6.1",
        "@storybook/addon-vitest": "^10.6.1",
        "@storybook/react-vite": "^10.6.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@tsdown/css": "0.22.14",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/coverage-v8": "5.0.3",
        "chromatic": "^18.11.0",
        "cross-var": "^1.1.0",
        "dotenv-cli": "^11.0.0",
        "jsdom": "^30.1.2",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "storybook": "^10.6.1",
        "tsdown": "0.22.14",
        "typescript": "6.0.3",
        "vitest": "^5.0.3"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "type": "module",
    "author": {
        "name": "Gillian Tunney",
        "email": "gbtunney@mac.com"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/gbtunney/snailicid3-consumer-monorepo",
        "directory": "packages/example-react"
    },
    "files": [
        "CHANGELOG.md",
        "dist",
        "types"
    ],
    "keywords": [
        "boilerplate"
    ],
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json",
        "./style.css": "./dist/style.css"
    },
    "sideEffects": [
        "**/*.css"
    ]
}
